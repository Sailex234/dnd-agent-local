# MongoDB: hojas de personaje (character_sheets) y jugadores (players).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=dnd_agent

# CORS para la web interna: origenes permitidos para las llamadas client-side del
# navegador (alta/edicion de hojas y jugadores). Default "*".
CORS_ALLOW_ORIGINS=*

# Credencial unica compartida (HTTP Basic) que exige toda la API. Debe coincidir con
# AUTH_USER/AUTH_PASSWORD de apps/web.
API_AUTH_USER=changeme
API_AUTH_PASSWORD=changeme
